# ---------------------------------------------------------------------------
# Nexo Propiedades · variables de entorno (EJEMPLO, sin valores reales)
#
# El demo NO necesita nada de esto: corre solo con los data.json.
# Cuando conectes el backend (ver docs/IMPLEMENTAR.md):
#   1. copiá este archivo:   cp .env.example .env.local
#   2. completá los valores en .env.local  (ese archivo NO se sube a git)
#   3. cargá las mismas variables en Vercel (Settings -> Environment Variables)
#
# NUNCA escribas valores reales en este archivo: es el único .env que se commitea.
# ---------------------------------------------------------------------------

# --- Supabase (base de datos + Auth). Van al navegador: solo la URL y la clave PÚBLICA ---
# Project Settings -> API en el panel de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon, o "publishable" en el panel nuevo).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SOLO SERVIDOR / SCRIPTS LOCALES. Jamás con prefijo NEXT_PUBLIC_ ---
# Clave service_role (o "secret key"): saltea RLS, da control total.
# Usala solo en tu computadora (script de carga), en Railway o en código de servidor.
# No la importes desde ningún componente "use client".
SUPABASE_SERVICE_ROLE_KEY=

# --- Worker de Railway (pg-boss). Se carga en Railway, NO en Vercel ---
# Cadena de conexión de Supabase (directa o pooler en modo sesión, puerto 5432).
DATABASE_URL=

# --- IA: elegí UNA. Solo servidor (Route Handler / Server Action) ---
OPENAI_API_KEY=
# Nombre del modelo, tomado de la lista oficial del proveedor (cambia seguido).
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
